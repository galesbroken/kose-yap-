<!-- Section 1: Hero Section -->
<section id="anasayfa" class="hero-section">
  <div class="hero-bg-overlay"></div>
  <div class="hero-bg-image"></div>
  
  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-badge animate-fade-in">
        <span class="badge-dot"></span>
        <span class="badge-text">Ankara Etimesgut Yapı & Dekorasyon</span>
      </div>

      <h1 class="hero-title animate-heading">
        Yapının Gücü, <br>
        <span class="text-accent">Detayların Zarafeti</span>
      </h1>

      <p class="hero-subtitle animate-body">
        Yapı ve dekorasyon ihtiyaçlarınız için doğru malzemeyi, doğru seçimle bulmanıza yardımcı oluyoruz.
      </p>

      <div class="hero-actions animate-actions">
        <a href="#urunler" class="btn btn-accent btn-lg">
          <span>Ürünleri Keşfet</span>
          <i data-lucide="arrow-right"></i>
        </a>
        <a href="tel:<%= company.phoneRaw %>" class="btn btn-outline-light btn-lg">
          <i data-lucide="phone"></i>
          <span>Bize Ulaşın</span>
        </a>
      </div>
    </div>
  </div>

  <div class="hero-scroll-indicator">
    <a href="#hakkimizda" aria-label="Aşağı Kaydır">
      <span class="scroll-text">Keşfet</span>
      <i data-lucide="chevron-down" class="scroll-icon"></i>
    </a>
  </div>
</section>

<!-- Section 2: Hero Alt Bilgi Bandı -->
<section class="hero-features-bar">
  <div class="container">
    <div class="features-grid">
      <% heroFeatures.forEach(function(item) { %>
        <div class="feature-card">
          <div class="feature-icon-wrapper">
            <i data-lucide="<%= item.icon %>"></i>
          </div>
          <div class="feature-info">
            <h3 class="feature-title"><%= item.title %></h3>
            <p class="feature-desc"><%= item.description %></p>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- Section 3: Hakkımızda -->
<section id="hakkimizda" class="section about-section">
  <div class="container">
    <div class="grid grid-2-col about-grid align-center">
      <div class="about-image-wrapper">
        <div class="about-image-frame">
          <img src="https://images.unsplash.com/photo-1600573472591-ee6c563aaec9?auto=format&fit=crop&w=1200&q=80" alt="Köse Yapı Dekorasyon Mağaza Atmosferi" loading="lazy" class="about-img main-img">
          <div class="image-accent-card">
            <i data-lucide="building"></i>
            <div>
              <strong>Fiziksel Mağaza Deneyimi</strong>
              <span>Etimesgut, Ankara</span>
            </div>
          </div>
        </div>
      </div>

      <div class="about-content">
        <div class="section-tag">
          <span class="tag-line"></span>
          <span>KURUMSAL HAKKIMIZDA</span>
        </div>

        <h2 class="section-title">
          Sağlam Yapılar, <br>
          <span class="text-gradient">Doğru Detaylarla Başlar</span>
        </h2>

        <p class="section-text">
          Köse Yapı Dekorasyon, Ankara Etimesgut Güzelkent Mahallesi'nde konumlanan fiziki mağazasında yapı malzemeleri ve dekorasyon çözümlerini bir arada sunmaktadır.
        </p>

        <p class="section-text text-muted">
          İster evinizde veya iş yerinizde yenileme planlıyor olun, ister projenize özel doğru malzeme arayışında olun; mağazamızda ürün seçeneklerini yakından inceleyerek karar verebilirsiniz.
        </p>

        <div class="about-highlights">
          <div class="highlight-item">
            <i data-lucide="check" class="check-icon"></i>
            <span>Malzemeleri dokunarak ve yerinde görerek seçme imkanı</span>
          </div>
          <div class="highlight-item">
            <i data-lucide="check" class="check-icon"></i>
            <span>Yapı ve dekorasyon ihtiyaçlarına yönelik seçkin ürün çeşitliliği</span>
          </div>
          <div class="highlight-item">
            <i data-lucide="check" class="check-icon"></i>
            <span>İhtiyacınıza odaklanan dürüst ve samimi hizmet anlayışı</span>
          </div>
        </div>

        <div class="about-cta-row">
          <a href="tel:<%= company.phoneRaw %>" class="btn btn-primary">
            <i data-lucide="phone-call"></i>
            <span><%= company.phone %></span>
          </a>
          <a href="<%= company.mapsUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            <i data-lucide="map-pin"></i>
            <span>Mağazayı Ziyaret Et</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Section 4: Ürün Kategorileri -->
<section id="urunler" class="section categories-section bg-darker">
  <div class="container">
    <div class="section-header text-center">
      <div class="section-tag justify-center">
        <span class="tag-line"></span>
        <span>ÜRÜN KOLEKSİYONU</span>
        <span class="tag-line"></span>
      </div>
      <h2 class="section-title">Yapı ve Yaşam Alanları İçin Çözümler</h2>
      <p class="section-subtitle">
        Mağazamızda inceleyebileceğiniz ana yapı ve dekorasyon malzeme kategorileri.
      </p>
    </div>

    <div class="grid grid-3-col categories-grid">
      <% categories.forEach(function(cat) { %>
        <div class="category-card">
          <div class="category-image-box">
            <img src="<%= cat.image %>" alt="<%= cat.title %> - Köse Yapı Dekorasyon" loading="lazy" class="category-img">
            <div class="category-overlay"></div>
            <span class="category-badge"><%= cat.badge %></span>
          </div>
          <div class="category-body">
            <span class="category-subtitle"><%= cat.subtitle %></span>
            <h3 class="category-title"><%= cat.title %></h3>
            <p class="category-desc"><%= cat.description %></p>
            <div class="category-footer">
              <a href="tel:<%= company.phoneRaw %>" class="category-link">
                <span>Mağazada İnceleyin</span>
                <i data-lucide="chevron-right"></i>
              </a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- Section 5: Editorial Malzeme / Doku Görsel Alanı -->
<section class="section editorial-section">
  <div class="container">
    <div class="section-header text-center">
      <div class="section-tag justify-center">
        <span class="tag-line"></span>
        <span>MİMARİ DOKULAR</span>
        <span class="tag-line"></span>
      </div>
      <h2 class="section-title">Mekanları Değiştiren Detaylar</h2>
      <p class="section-subtitle">
        Doğal taşlar, sıcak ahşap dokular ve modern yüzeyler ile alanlarınıza derinlik kazandırın.
      </p>
    </div>

    <div class="editorial-grid">
      <% editorialTextures.forEach(function(tex, index) { %>
        <div class="editorial-card editorial-card-<%= index + 1 %>">
          <img src="<%= tex.image %>" alt="<%= tex.title %>" loading="lazy" class="editorial-img">
          <div class="editorial-overlay"></div>
          <div class="editorial-content">
            <span class="editorial-tag"><%= tex.tag %></span>
            <h3 class="editorial-title"><%= tex.title %></h3>
            <p class="editorial-desc"><%= tex.description %></p>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- Section 6: Dekorasyon Bölümü -->
<section class="section showcase-section bg-darker">
  <div class="container">
    <div class="showcase-banner">
      <div class="showcase-bg-image"></div>
      <div class="showcase-overlay"></div>
      
      <div class="showcase-content">
        <div class="section-tag light-tag">
          <span class="tag-line"></span>
          <span>ESTETİK & İŞLEV</span>
        </div>
        <h2 class="showcase-title">Yaşam Alanınıza Kendi Karakterini Katın</h2>
        <p class="showcase-text">
          Doğru malzeme seçimi, bir mekanın yalnızca görünümünü değil, kullanım hissini ve atmosferini de değiştirir.
        </p>
        <div class="showcase-actions">
          <a href="#urunler" class="btn btn-accent btn-lg">
            <span>Seçenekleri İncele</span>
            <i data-lucide="arrow-right"></i>
          </a>
          <a href="tel:<%= company.phoneRaw %>" class="btn btn-outline-light btn-lg">
            <i data-lucide="phone"></i>
            <span>Bilgi Alın</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Section 7: Hizmetler -->
<section id="hizmetler" class="section services-section">
  <div class="container">
    <div class="section-header text-center">
      <div class="section-tag justify-center">
        <span class="tag-line"></span>
        <span>MAĞAZA HİZMETLERİMİZ</span>
        <span class="tag-line"></span>
      </div>
      <h2 class="section-title">İhtiyacınız İçin Doğru Seçim</h2>
      <p class="section-subtitle">
        Fiziksel mağazamızda sunduğumuz temel yaklaşım ve destek süreçleri.
      </p>
    </div>

    <div class="grid grid-2-col services-grid">
      <% services.forEach(function(srv) { %>
        <div class="service-card">
          <div class="service-icon-box">
            <i data-lucide="<%= srv.icon %>"></i>
          </div>
          <div class="service-content">
            <h3 class="service-title"><%= srv.title %></h3>
            <p class="service-desc"><%= srv.description %></p>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- Section 8: Neden Köse Yapı Dekorasyon? -->
<section id="neden-biz" class="section why-section bg-darker">
  <div class="container">
    <div class="section-header text-center">
      <div class="section-tag justify-center">
        <span class="tag-line"></span>
        <span>NEDEN BİZİ TERCİH ETMELİSİNİZ?</span>
        <span class="tag-line"></span>
      </div>
      <h2 class="section-title">Doğru Malzeme, Doğru Mekan</h2>
      <p class="section-subtitle">
        Projenize değer katan dürüst, dürüst ve kaliteli hizmet anlayışımız.
      </p>
    </div>

    <div class="grid grid-4-col why-grid">
      <% whyChooseUs.forEach(function(item) { %>
        <div class="why-card">
          <span class="why-number"><%= item.number %></span>
          <h3 class="why-title"><%= item.title %></h3>
          <p class="why-desc"><%= item.description %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- Section 9: Google Maps Güven Alanı -->
<section class="trust-badge-section">
  <div class="container text-center">
    <div class="trust-badge-container">
      <div class="google-logo">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
      </div>
      <div class="trust-stars">★★★★★</div>
      <div class="trust-text">
        <strong><%= company.googleRating %></strong> Google Haritalar Değerlendirmesi
      </div>
    </div>
  </div>
</section>

<!-- Section 10 & 11: Mağaza Bilgileri & Çalışma Saatleri -->
<section id="iletisim" class="section location-section">
  <div class="container">
    <div class="grid grid-2-col location-grid">
      <div class="location-info-card">
        <div class="section-tag">
          <span class="tag-line"></span>
          <span>BİZİ ZİYARET EDİN</span>
        </div>

        <h2 class="section-title">Mağazamıza Bekliyoruz</h2>
        <p class="section-text">
          Malzeme seçeneklerimizi yakından görmek ve projeniz için doğrudan fikir almak adına Güzelkent'teki mağazamızı ziyaret edebilirsiniz.
        </p>

        <div class="contact-details-list">
          <div class="contact-detail-item">
            <div class="detail-icon"><i data-lucide="map-pin"></i></div>
            <div class="detail-text">
              <strong>Mağaza Adresi</strong>
              <p><%= company.address %></p>
            </div>
          </div>

          <div class="contact-detail-item">
            <div class="detail-icon"><i data-lucide="phone"></i></div>
            <div class="detail-text">
              <strong>Telefon İletişim</strong>
              <p><a href="<%= company.phoneTel %>" class="phone-link"><%= company.phone %></a></p>
            </div>
          </div>

          <div class="contact-detail-item">
            <div class="detail-icon"><i data-lucide="clock"></i></div>
            <div class="detail-text">
              <strong>Çalışma Saatleri</strong>
              <p><%= company.openingInfo %></p>
            </div>
          </div>
        </div>

        <div class="location-actions">
          <a href="<%= company.mapsUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-accent btn-lg">
            <i data-lucide="navigation"></i>
            <span>Yol Tarifi Al</span>
          </a>
          <a href="<%= company.phoneTel %>" class="btn btn-outline btn-lg">
            <i data-lucide="phone-call"></i>
            <span>Bizi Arayın</span>
          </a>
        </div>
      </div>

      <div class="location-map-card">
        <div class="map-placeholder">
          <div class="map-bg"></div>
          <div class="map-card-inner">
            <i data-lucide="map-pin" class="map-pin-big"></i>
            <h3>KÖSE YAPI DEKORASYON</h3>
            <p><%= company.address %></p>
            <a href="<%= company.mapsUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm mt-2">
              Google Maps'te Aç
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Section 12: Son CTA -->
<section class="section final-cta-section bg-darker text-center">
  <div class="container">
    <div class="final-cta-box">
      <div class="section-tag justify-center">
        <span class="tag-line"></span>
        <span>YAPINIZ İÇİN DOĞRU ADIM</span>
        <span class="tag-line"></span>
      </div>
      <h2 class="final-cta-title">Yapınıza Değer Katın</h2>
      <p class="final-cta-desc">
        Yapı ve dekorasyon ihtiyaçlarınız için mağazamızı ziyaret edin, malzeme seçeneklerini yerinde keşfedin.
      </p>

      <div class="final-cta-buttons justify-center">
        <a href="<%= company.mapsUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-accent btn-xl">
          <i data-lucide="navigation"></i>
          <span>Yol Tarifi Al</span>
        </a>
        <a href="tel:<%= company.phoneRaw %>" class="btn btn-outline-light btn-xl">
          <i data-lucide="phone"></i>
          <span><%= company.phone %></span>
        </a>
      </div>
    </div>
  </div>
</section>
