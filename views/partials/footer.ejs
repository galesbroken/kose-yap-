<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Col 1: Brand Info -->
      <div class="footer-col footer-brand-col">
        <a href="/" class="brand-logo footer-logo">
          <span class="logo-main">KÖSE YAPI</span>
          <span class="logo-sub">DEKORASYON</span>
        </a>
        <p class="footer-desc">
          Yapı ve dekorasyon ihtiyaçlarınız için modern malzeme seçenekleri ve güvenilir mağaza deneyimi.
        </p>
        <div class="footer-trust-badge">
          <div class="stars">★★★★★</div>
          <span><%= company.googleRating %> Google Değerlendirmesi</span>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="footer-col">
        <h3 class="footer-heading">Hızlı Bağlantılar</h3>
        <ul class="footer-links">
          <li><a href="#anasayfa">Ana Sayfa</a></li>
          <li><a href="#hakkimizda">Hakkımızda</a></li>
          <li><a href="#urunler">Ürün Kategorileri</a></li>
          <li><a href="#hizmetler">Hizmetlerimiz</a></li>
          <li><a href="#neden-biz">Neden Biz?</a></li>
          <li><a href="#iletisim">İletişim</a></li>
        </ul>
      </div>

      <!-- Col 3: Product Highlights -->
      <div class="footer-col">
        <h3 class="footer-heading">Ürün Odakları</h3>
        <ul class="footer-links">
          <li><a href="#urunler">Seramik & Zemin</a></li>
          <li><a href="#urunler">Banyo Çözümleri</a></li>
          <li><a href="#urunler">Mutfak Malzemeleri</a></li>
          <li><a href="#urunler">Ahşap & Parke</a></li>
          <li><a href="#urunler">Dekorasyon Panelleri</a></li>
          <li><a href="#urunler">Yapı Malzemeleri</a></li>
        </ul>
      </div>

      <!-- Col 4: Contact & Location -->
      <div class="footer-col">
        <h3 class="footer-heading">İletişim & Konum</h3>
        <ul class="footer-contact-info">
          <li>
            <i data-lucide="map-pin"></i>
            <span><%= company.address %></span>
          </li>
          <li>
            <i data-lucide="phone"></i>
            <a href="<%= company.phoneTel %>"><%= company.phone %></a>
          </li>
          <li>
            <i data-lucide="clock"></i>
            <span><%= company.openingInfo %></span>
          </li>
          <li>
            <i data-lucide="globe"></i>
            <a href="<%= company.website %>" target="_blank" rel="noopener noreferrer">Mevcut Web Sitemiz (koseyapi.com)</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-bottom-inner">
        <p class="copyright">
          &copy; <%= new Date().getFullYear() %> Köse Yapı Dekorasyon. Tüm Hakları Saklıdır.
        </p>

        <!-- MANDATORY ATTRIBUTION LINK -->
        <p class="attribution">
          <a href="https://armesbilisim.com" target="_blank" rel="noopener noreferrer" class="attribution-link">
            Armes Bilişim tarafından oluşturulmuştur
          </a>
        </p>
      </div>
    </div>
  </div>
</footer>
